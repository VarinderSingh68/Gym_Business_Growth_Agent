# API_PORT is only used for local dev. In production (Render), the platform
# sets PORT itself and the server picks that up automatically - do not set
# PORT manually on Render.
API_PORT=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=volt-fitness

# This app is deployed as a single service that serves both the React build
# and the API from the same origin. Locally that origin is localhost:3000
# (the CRA dev server proxies API calls to 127.0.0.1:4000). On Render, set
# FRONTEND_URL to your Render service's own public URL, e.g.
# https://your-app.onrender.com
FRONTEND_URL=http://localhost:3000

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# On Render, GOOGLE_REDIRECT_URI must be:
# https://your-app.onrender.com/api/auth/google/callback
# ...and that same URL must be added as an Authorized redirect URI in the
# Google Cloud Console OAuth client.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback

# Outbound email (Gmail SMTP + App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=your_gmail_address@gmail.com
