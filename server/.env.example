API_PORT=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=volt-fitness

# Frontend origin, used to redirect back after Google Sign-In
FRONTEND_URL=http://localhost:3000

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback

# Outbound email (Gmail SMTP + App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=your_gmail_address@gmail.com
